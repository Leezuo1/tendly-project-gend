# Copy this file to .env.local and fill in your server-only values.
# Never use NEXT_PUBLIC_ prefixes for secrets.

# Gemini AI
GEMINI_API_KEY=
# Optional: override the default Gemini model.
# GEMINI_MODEL=

# Facebook Messenger
# Page access token generated for your test Page.
PAGE_ACCESS_TOKEN=
# App Secret from the Meta app dashboard.
APP_SECRET=
# Numeric ID of your Facebook Page.
PAGE_ID=
# A private value you choose; enter the same value in Meta webhook setup.
VERIFY_TOKEN=

# Postgres connection string. Required locally and on Vercel; use the provider's pooled URL.
# After filling this in, run: npm run db:migrate
DATABASE_URL=

# Private access code for the Messenger dashboard, at least 24 random characters.
# Enter it in the Inbox screen; never expose it with NEXT_PUBLIC_.
INBOX_ACCESS_KEY=
# Match the supported Graph API version configured for your Meta app (e.g. v23.0).
META_GRAPH_VERSION=

# Shopee: one real VN demo shop. Server only; never use NEXT_PUBLIC_.
# Get Partner ID / Partner Key from the same Shopee app environment.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# The one numeric shop ID allowed to authorize this Tendly instance.
SHOPEE_SHOP_ID=
# Must match the domain declared in Shopee Console and the URL used to open Tendly.
SHOPEE_REDIRECT_URL=https://your-tendly-domain/api/shopee/callback
# true = sandbox test shop; false = production credentials + real shop.
SHOPEE_SANDBOX=false
# Tokens and the latest catalog use Postgres and the existing Facebook access session.

# Mã quản trị bảo vệ API soạn/lưu/đăng bài (Marketing → Soạn bài AI).
# Bắt buộc trên production (Vercel); local bỏ trống vẫn chạy được. Dùng chuỗi dài, ngẫu nhiên.
DASHBOARD_KEY=
